  RadioSeconds: 35
  RadioSteps:
  - Prompt: "\u041D\u0430 \u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u0441\u0445\u0435\u043C\u0435
      \u0421\u043E\u043C\u043E\u0432\u0430 \u0443\u043A\u0430\u0437\u0430\u043D \u043A\u0430\u043D\u0430\u043B:
      \u0420\u0410\u0414\u0418\u041E\u0423\u0417\u0415\u041B. \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      \u043F\u0443\u043D\u043A\u0442 \u0441\u0432\u044F\u0437\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0437\u0432\u0430\u0442\u044C \u043D\u0443\u0436\u043D\u043E\u0433\u043E
      \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0430."
    Options:
    - "\u041A\u0430\u043D\u0430\u043B: \u0436\u0438\u043B\u043E\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B"
    - "\u041A\u0430\u043D\u0430\u043B: \u0440\u0430\u0434\u0438\u043E\u0443\u0437\u0435\u043B"
    - "\u041A\u0430\u043D\u0430\u043B: \u044D\u043D\u0435\u0440\u0433\u043E\u0431\u043B\u043E\u043A"
    CorrectOption: 1
  - Prompt: "\u0412\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0437\u0430\u043F\u0440\u043E\u0441:
      \xAB\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430\u044F \u0431\u0443\u043A\u0432\u0430?\xBB
      \u0414\u0435\u0444\u0435\u043A\u0442 \u043C\u0430\u0448\u0438\u043D\u043A\u0438
      \u2014 \u0441\u043A\u043E\u043B\u043E\u0442\u0430\u044F \xAB\u043A\xBB. \u041F\u0435\u0440\u0435\u0434\u0430\u0439\u0442\u0435
      \u043A\u043E\u0434, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u043F\u0440\u0438\u043C\u0435\u0442\u0443
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F."
    Options:
    - "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C: \u043D\u043E\u043B\u044C"
    - "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C: \u041E"
    - "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C: \u043A"
    CorrectOption: 2
  - Prompt: "\u0410\u0434\u0440\u0435\u0441\u0430\u0442 \u043F\u0440\u0438\u043D\u044F\u043B
      \u043A\u043E\u0434. \u041A\u0443\u0440\u044C\u0435\u0440\u0441\u043A\u0438\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438\u0434\u0451\u0442 \u043A
      \u0432\u043E\u043A\u0437\u0430\u043B\u0443. \u041D\u0430\u043F\u0440\u0430\u0432\u044C\u0442\u0435
      \u0430\u0433\u0435\u043D\u0442\u0430 \u043A \u043C\u0435\u0441\u0442\u0443,
      \u0433\u0434\u0435 \u0435\u0433\u043E \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043E\u043F\u0435\u0440\u0433\u0440\u0443\u043F\u043F\u0430."
    Options:
    - "\u0412\u0441\u0442\u0440\u0435\u0447\u0430: \u0441\u0435\u043A\u0442\u043E\u0440
      1, \u0432\u043E\u043A\u0437\u0430\u043B"
    - "\u0412\u0441\u0442\u0440\u0435\u0447\u0430: \u0441\u0435\u043A\u0442\u043E\u0440
      4, \u043F\u043E\u0434\u0441\u0442\u0430\u043D\u0446\u0438\u044F"
    - "\u0412\u0441\u0442\u0440\u0435\u0447\u0430: \u0441\u0435\u043A\u0442\u043E\u0440
      2, \u043A\u043B\u0443\u0431"
    CorrectOption: 0
