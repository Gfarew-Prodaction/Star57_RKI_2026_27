  DeliveredByYura: 1
  Id: 0.1
  VisitorName: "\u0424\u043E\u043C\u0438\u043D \xB7 \u0443\u0447\u0435\u0431\u043D\u0430\u044F
    \u043F\u0430\u043F\u043A\u0430 \u0447\u0435\u0440\u0435\u0437 \u042E\u0440\u0443"
  Greeting: "\u042E\u0440\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0443\u0447\u0435\u0431\u043D\u0443\u044E
    \u043F\u0430\u043F\u043A\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
  Portrait: {fileID: 0}
  PortraitTint: {r: 0.3, g: 0.4, b: 0.45, a: 1}
  Documents:
  - Title: "\u0423\u0427\u0415\u0411\u041D\u041E\u0415 \u0414\u0415\u041B\u041E 0.1"
    Body: "\u0424\u043E\u043C\u0438\u043D\n\u041A\u0411-88 \u2192 \u042D\u043D\u0435\u0440\u0433\u043E\u0431\u043B\u043E\u043A\n\u041F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u043E\u0442 13 \u043E\u043A\u0442\u044F\u0431\u0440\u044F 1957\n\u0420\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u044B
      \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0438 \u0441\u0440\u043E\u043A
      \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B.\n\n\u041F\u043E\u0440\u044F\u0434\u043E\u043A
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438: \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u043B\u0438\u0441\u0442, \u0432\u0437\u044F\u0442\u044C \u0448\u0442\u0430\u043C\u043F,
      \u043A\u043E\u0441\u043D\u0443\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u0443\u0448\u043A\u0438,
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0442\u0442\u0438\u0441\u043A
      \u0438 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0441\u0434\u0430\u0447\u0443."
    Evidence: []
  - Title: "\u041F\u0410\u041C\u042F\u0422\u041A\u0410 \u0414\u0415\u0416\u0423\u0420\u041D\u041E\u041C\u0423"
    Body: "\u041B\u041A\u041C \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435.
      \u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u2014 \u043F\u0435\u0440\u0435\u043D\u043E\u0441
      \u0431\u0443\u043C\u0430\u0433\u0438.\n\u041D\u0430\u0437\u0430\u0434 \u2014
      \u043E\u0431\u0449\u0438\u0439 \u0440\u0430\u043A\u0443\u0440\u0441.\n\u041D\u0430
      \u043A\u0430\u0440\u0442\u0435: \u0432\u044B\u0431\u0440\u0430\u0442\u044C
      \u0448\u0442\u0435\u043A\u0435\u0440, \u0437\u0430\u0442\u0435\u043C \u0441\u0435\u043A\u0442\u043E\u0440.\n\u0420\u0435\u043C\u043E\u043D\u0442\u043D\u0438\u043A\u0438
      \u0443\u0441\u0442\u0440\u0430\u043D\u044F\u044E\u0442 \u043D\u0435\u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0441\u0435\u043A\u0442\u043E\u0440\u0435 2.\n\n\u0421\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A
      \u2014 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.\n\u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
      \u043C\u044B\u0448\u044C\u044E."
    Evidence: []
  Verdicts:
  - Verdict: 0
    Accepted: 1
    Feedback: "\u0423\u0447\u0435\u0431\u043D\u043E\u0435 \u0434\u0435\u043B\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043E \u0432\u0435\u0440\u043D\u043E."
    IncidentId: 
    Metrics:
      Reactor: 2
      Secrecy: 0
      Calm: 0
  - Verdict: 1
    Accepted: 0
    Feedback: "\u0420\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u044B \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B:
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u043E\u0441\u044C \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    IncidentId: 
