        height: 0.75
      Finding: "\u0423\u0424: \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F \u0441\u0435\u0442\u043A\u0430
        \xAB\u0410\u0422\u041E\u041C-57\xBB \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442."
  - Title: "\u0421\u041E\u041F\u0420\u041E\u0412\u041E\u0414\u0418\u0422\u0415\u041B\u042C\u041D\u042B\u0419
      \u041B\u0418\u0421\u0422"
    Body: "\u041E\u0441\u043E\u0431\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440\n\n\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C:
      \u043C\u0430\u0439\u043E\u0440 \u0413\u043B\u0435\u0431 \u041A\u043E\u0432\u0430\u043B\u0451\u0432\n\u041F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u044C:
      \u0412\u0435\u0442\u0440\u043E\u0432\n\n\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0438 \u0440\u0435\u043A\u0432\u0438\u0437\u0438\u0442\u044B.\n\u0422\u0435\u043B\u0435\u0444\u043E\u043D\u044B:
      204 \u2014 \u0430\u0440\u0445\u0438\u0432, 315 \u2014 \u041A\u041F\u041F, 501
      \u2014 \u0441\u043A\u043B\u0430\u0434."
    Evidence: []
