  Id: YURA_COURIER
  Speaker: "\u042E\u0440\u0430 \xB7 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F"
  Text: "\u041A\u0443\u0440\u044C\u0435\u0440\u0441\u043A\u0438\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
    \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D: \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
    \u0438\u0434\u0443\u0442 \u043A \u0432\u043E\u043A\u0437\u0430\u043B\u0443. \u0422\u0435\u043F\u0435\u0440\u044C
    \u043E\u043F\u0435\u0440\u0433\u0440\u0443\u043F\u043F\u0430 \u043C\u043E\u0436\u0435\u0442
    \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442
    \u0431\u0435\u0437 \u0440\u0430\u0434\u0438\u043E\u0438\u0433\u0440\u044B. \u041D\u0430
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C \u0432\u044B\u0437\u043E\u0432\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u044C\u0442\u0435 \u0435\u0451 \u0432 \u0441\u0435\u043A\u0442\u043E\u0440
    1 \u0434\u043E \u0443\u0445\u043E\u0434\u0430 \u043F\u043E\u0435\u0437\u0434\u0430."
  Choices:
  - Text: "\u041F\u0435\u0440\u0435\u0434\u0430\u044E \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0443
      \u043E\u043F\u0435\u0440\u0433\u0440\u0443\u043F\u043F\u0435."
