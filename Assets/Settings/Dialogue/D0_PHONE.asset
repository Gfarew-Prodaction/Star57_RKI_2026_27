  Id: D0_PHONE
  Speaker: "\u0413\u0435\u043D\u0435\u0440\u0430\u043B \u0420\u0443\u0434\u0435\u043D\u043A\u043E
    \xB7 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D"
  Text: "\u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442
    \u0430\u0433\u0435\u043D\u0442 \xAB\u041A\u0432\u0430\u0440\u0446\xBB. \u0414\u043E
    \u043F\u0443\u0441\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u0442\u0440\u0438 \u0441\u043C\u0435\u043D\u044B. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B,
    \u0432\u044B\u0437\u043E\u0432\u044B \u0438 \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C
    \u0440\u0435\u0430\u043A\u0442\u043E\u0440\u0430 \u0441\u0432\u044F\u0437\u0430\u043D\u044B.
    \u041D\u0435 \u0442\u0435\u0440\u044F\u0439\u0442\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B. \u0417\u0430\u0432\u0435\u0440\u0448\u0430\u0439\u0442\u0435
    \u0441\u043C\u0435\u043D\u0443 \u043F\u043E\u0441\u043B\u0435 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0441 \u0434\u0435\u043B\u0430\u043C\u0438 \u0438 \u0432\u044B\u0437\u043E\u0432\u0430\u043C\u0438."
  Choices:
  - Text: "\u0417\u0430\u0434\u0430\u0447\u0443 \u043F\u043E\u043D\u044F\u043B."
