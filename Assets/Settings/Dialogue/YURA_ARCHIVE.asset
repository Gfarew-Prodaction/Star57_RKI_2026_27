  Id: YURA_ARCHIVE
  Speaker: "\u042E\u0440\u0430 \xB7 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F"
  Text: "\u0410\u0440\u0445\u0438\u0432\u043D\u0430\u044F \u0441\u0432\u0435\u0440\u043A\u0430
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430. \u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043D\u0430 \u0441\u0440\u043E\u043A\u0438
    \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F \u0438 \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u043E\u0441\u0442\u044C
    \u043F\u0440\u0438\u043A\u0430\u0437\u043E\u0432. \u041B\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u041C\u043E\u0440\u043E\u0437\u043E\u0432\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
    \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u043F\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443 204 \u2014 \u0444\u0430\u043A\u0442
    \u043F\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u043C\u0443
    \u0434\u0435\u043B\u0443 \u043D\u0435 \u0437\u0430\u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u043E\u0431\u0449\u0438\u043C \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435\u043C."
  Choices:
  - Text: "\u041F\u0440\u0438\u043D\u044F\u0442\u043E."
