  m_Name: D1_INTRO
  m_EditorClassIdentifier: Assembly-CSharp::Zvezda57.Systems.DialogueDefinition
  Id: D1_INTRO
  Speaker: "\u042E\u0440\u0430"
  Text: "\u0412\u0435\u0442\u0440\u043E\u0432 \u0438\u0437 \u041D\u0418\u0418-42
    \u043F\u0440\u0438\u0435\u0445\u0430\u043B \u0440\u0430\u043D\u044C\u0448\u0435
    \u0441\u0440\u043E\u043A\u0430. \u042F \u0437\u043D\u0430\u044E \u0435\u0433\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0410\u043D\u044E, \u043D\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
    \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043D\u0430\u0434\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u0430\u043A\u0436\u0435 \u0436\u0434\u0451\u043C
    \u0433\u0440\u0443\u0437 \u0421\u0435\u043C\u0451\u043D\u043E\u0432\u0430."
  Choices:
  - Text: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F
      \u0434\u043E\u043F\u0443\u0441\u043A\u0430."
