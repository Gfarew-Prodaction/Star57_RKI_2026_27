  m_Script: {fileID: 11500000, guid: a2487df392aeb44109b80d725abdc57e, type: 3}
  m_Name: D3_YURA
  m_EditorClassIdentifier: Assembly-CSharp::Zvezda57.Systems.DialogueDefinition
  Id: D3_YURA
  Speaker: "\u042E\u0440\u0430"
  Text: "\u0421\u043A\u043E\u043B\u043E\u0442\u0430\u044F \xAB\u043A\xBB \u2014 \u0441
    \u043C\u043E\u0435\u0439 \u043C\u0430\u0448\u0438\u043D\u043A\u0438. \u0415\u044E
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F \u0412\u0435\u0442\u0440\u043E\u0432.
    \u0421\u043A\u0440\u044B\u0442\u0430\u044F \u0441\u0445\u0435\u043C\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442
    \u043A\u0430\u043D\u0430\u043B \u0441\u0432\u044F\u0437\u0438. \u0415\u0441\u043B\u0438
    \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043C\u043D\u0435, \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u043C
    \u0440\u0430\u0434\u0438\u043E\u0438\u0433\u0440\u0443 \u0438 \u0432\u044B\u0432\u0435\u0434\u0435\u043C
    \u0435\u0433\u043E \u043A \u0432\u043E\u043A\u0437\u0430\u043B\u0443. \u0418\u043D\u0430\u0447\u0435
    \u043D\u0443\u0436\u0435\u043D \u043A\u0443\u0440\u044C\u0435\u0440\u0441\u043A\u0438\u0439
    \u0441\u043B\u0435\u0434."
  Choices:
  - Text: "\u0414\u043E\u0432\u0435\u0440\u044F\u044E. \u0413\u043E\u0442\u043E\u0432\u044C
      \u0440\u0430\u0434\u0438\u043E\u0438\u0433\u0440\u0443."
    TrustDelta: 0
    SetFlag: RadioGame
    MinimumTrust: 2
    RequiredFlag: 
  - Text: "\u0411\u0443\u0434\u0435\u043C \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u043F\u043E \u043A\u0443\u0440\u044C\u0435\u0440\u0441\u043A\u043E\u043C\u0443
      \u0441\u043B\u0435\u0434\u0443."
    TrustDelta: 0
    SetFlag: 
    MinimumTrust: -100
    RequiredFlag: 
