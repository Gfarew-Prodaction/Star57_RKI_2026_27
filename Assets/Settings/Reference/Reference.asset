  Tabs:
  - "\u0423\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F"
  - "\u0413\u0440\u0443\u0437\u044B"
  - "\u0422\u0435\u043B\u0435\u0444\u043E\u043D\u044B"
  - "\u0417\u0430\u0449\u0438\u0442\u0430"
  Pages:
  - "\u0423\u0427\u0420\u0415\u0416\u0414\u0415\u041D\u0418\u042F\n\n\u041D\u0418\u0418-42
    \u2014 \u0430\u043A\u0443\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F.\n\u041A\u0411-88
    \u2014 \u044D\u043D\u0435\u0440\u0433\u043E\u0431\u043B\u043E\u043A.\n\u041D\u0418\u0418-12
    \u2014 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435 \u0434\u0440\u0443\u0433\u043E\u0433\u043E
    \u0433\u043E\u0440\u043E\u0434\u0430.\n\n\u0421\u0432\u0435\u0440\u044F\u0439\u0442\u0435
    \u043C\u0435\u0441\u0442\u043E \u0440\u0430\u0431\u043E\u0442\u044B, \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
    \u0438 \u0441\u0440\u043E\u043A \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u044F
    \u0441 \u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C."
  - "\u041C\u0410\u0420\u0428\u0420\u0423\u0422\u042B \u0413\u0420\u0423\u0417\u041E\u0412\n\n\u0413\u0420-01
    \u2014 \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u0438\u0435.\n\u0413\u0420-04
    \u2014 \u0442\u044F\u0436\u0451\u043B\u0430\u044F \u0432\u043E\u0434\u0430, \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F
    \xAB\u0422\u043E\u043A\u0430\u043C\u0430\u043A\xBB, \u0441\u0435\u043A\u0442\u043E\u0440
    3.\n\u0413\u0420-09 \u2014 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u043F\u043E \u0441\u043F\u0435\u0446\u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u044E.\n\n\u0416\u0438\u043B\u043E\u0439
    \u0441\u0435\u043A\u0442\u043E\u0440 \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u0432\u043E\u0434\u0443."
  - "\u0421\u041B\u0423\u0416\u0415\u0411\u041D\u042B\u0415 \u0422\u0415\u041B\u0415\u0424\u041E\u041D\u042B\n\n204
    \u2014 \u0430\u0440\u0445\u0438\u0432\n315 \u2014 \u041A\u041F\u041F\n501 \u2014
    \u0441\u043A\u043B\u0430\u0434\n\n\u041E\u0442\u0432\u0435\u0442 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u0442\u0435\u043A\u0443\u0449\u0435\u0439 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u043E\u0439
    \u043F\u0430\u043F\u043A\u0435. \u0417\u0432\u043E\u043D\u043E\u043A \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
    \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0451\u043D\u043D\u044B\u0435
    \u0444\u0430\u043A\u0442\u044B."
  - "\u041F\u0420\u041E\u0412\u0415\u0420\u041A\u0410 \u0411\u0423\u041C\u0410\u0413\n\n\u041B\u0443\u043F\u0430:
    \u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
    \u0441\u0432\u0435\u0440\u044F\u0439\u0442\u0435 \u0448\u0442\u0440\u0438\u0445\u0438
    \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044C.\n\n\u0423\u0424: \u0437\u0430\u0449\u0438\u0442\u043D\u0430\u044F
    \u0441\u0435\u0442\u043A\u0430 \xAB\u0410\u0422\u041E\u041C-57\xBB. \u041F\u043E\u0434\u043B\u0438\u043D\u043D\u0430\u044F
    \u0441\u0435\u0442\u043A\u0430 \u0441\u0430\u043C\u0430 \u043F\u043E \u0441\u0435\u0431\u0435
    \u043D\u0435 \u0443\u0434\u043E\u0441\u0442\u043E\u0432\u0435\u0440\u044F\u0435\u0442
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C.\n\n\u041F\u0440\u043E\u0442\u043E\u0442\u0438\u043F:
    \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
    \u0441\u0440\u0430\u0437\u0443."
