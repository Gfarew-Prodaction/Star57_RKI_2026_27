  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u042E\u0440\u0430\n\n\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0443\u0441\u043A. \u041B\u0430\u0432\u0440\u0435\u043D\u0442\u044C\u0435\u0432 \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u0442 \u0441\u043F\u0435\u0446\u043F\u0440\u0435\u0434\u043F\u0438\u0441\u0430\u043D\u0438\u0435, \u0430 \u043A\u0443\u0440\u044C\u0435\u0440 \u0421\u043E\u043C\u043E\u0432 \u2014 \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u0443\u044E \u0441 \u0440\u0430\u0434\u0438\u043E\u0433\u0440\u0430\u043C\u043C\u043E\u0439. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435 \u0431\u0443\u043C\u0430\u0433\u0443 \u043B\u0443\u043F\u043E\u0439 \u0438 \u0423\u0424. \u0415\u0441\u043B\u0438 \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u0442 \u0434\u043B\u044F \u0440\u0430\u0434\u0438\u043E\u0438\u0433\u0440\u044B, \u043F\u043E\u0440\u0443\u0447\u0438\u0442\u0435 \u043C\u043D\u0435 \u043F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0437\u0430 \u043A\u0443\u0440\u044C\u0435\u0440\u043E\u043C."
  m_isRightToLeft: 0
